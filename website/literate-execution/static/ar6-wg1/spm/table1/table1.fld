from typing import Callable
from dataclasses import dataclass
from fluid.stats import Likelihood, likelihood_map

from fluid.view import MultiView
from fluid.prelude import fsum, max, min

@dataclass
class Projection:
  scenario: str
  bestEstNear: float
  lowNear: float
  highNear: float
  bestEstMid: float
  lowMid: float
  highMid: float
  bestEstLate: float
  lowLate: float
  highLate: float

tableData: list[Projection] = @doc("tableData") load_json(list[Projection], "../../dataset/SPM/explainable-table.json")
likelihoods: list[Likelihood] = @doc("likelihoods") load_json(list[Likelihood], "../../dataset/SPM/likelihoods.json")

@dataclass
class Scenario:
  scenario: str
  beNear: float
  nearRange: tuple[float, float]
  beMid: float
  midRange: tuple[float, float]
  beLong: float
  longRange: tuple[float, float]

def newDataTable(offset: float) -> list[Scenario]:
  return [Scenario(
    scenario=s.scenario,
    beNear=s.bestEstNear + offset,
    nearRange=(s.lowNear, s.highNear),
    beMid=s.bestEstMid,
    midRange=(s.lowMid, s.highMid),
    beLong=s.bestEstLate,
    longRange=(s.lowLate, s.highLate)
  ) for s in tableData]

def getByScenario(data: list[Scenario], scenario: str) -> Scenario:
  return [r for r in data if r.scenario == scenario][0]

probAsText: Callable[[float], str] = likelihood_map(likelihoods)

def mean(xs: list[float]) -> float:
  return fsum(xs) / len(xs)

def calcLikelihood((min, max): tuple[float, float], target: float) -> float:
  if max < target:
    return 0.05
  if target <= min:
    return 0.95
  return (target - min) / (max - min)

getByScenario_: Callable[[str], Scenario] = getByScenario(newDataTable(0))
ssp119: Scenario = getByScenario_("SSP1-1.9")
ssp245: Scenario = getByScenario_("SSP2-4.5")

MultiView([
  f"""Under the low GHG emissions scenario (SSP1-1.9), global warming of 2°C would
      {probAsText(calcLikelihood(ssp119.longRange, 2.0))}
      be exceeded at the end of the 21st century.""",
  f"""Under the intermediate GHG emissions scenario (SSP2-4.5), global warming of 2°C would
      {probAsText(calcLikelihood(ssp245.longRange, 2.0))} be exceeded by the end of the 21st century.
      In the mid-term period (2041-2060), crossing the 2°C mark is
      {probAsText(calcLikelihood(ssp245.midRange, 2.0))} to occur."""
])
