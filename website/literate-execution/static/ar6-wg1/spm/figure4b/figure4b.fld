from dataclasses import dataclass
from fluid.stats import find_percentile, cut

from fluid.view import BarChart, Dimensions, MultiView, Segment, StackedBar, TickLabels, Default, Link
from fluid.prelude import fsum, map, maximum, minimum

@dataclass
class Emission:
  type: str
  emissions: float

@dataclass
class Prediction:
  model: str
  period: str
  world: float
  world_historical: float
  changed: float

ssp126Source: list[Emission] = @doc("ssp126Source") load_json(list[Emission], "../../dataset/SPM/ssp126.json")
ssp126preds: list[Prediction] = @doc("ssp126preds") load_json(list[Prediction], "../../dataset/SPM/ssp126preds.json")
ssp245Source: list[Emission] = @doc("ssp245Source") load_json(list[Emission], "../../dataset/SPM/ssp245.json")
ssp245preds: list[Prediction] = @doc("ssp245preds") load_json(list[Prediction], "../../dataset/SPM/ssp245preds.json")

def stackedBarHeight(stackedBar: StackedBar) -> float:
  return fsum([segment.z for segment in stackedBar.segments])

def get(x: str, bar: BarChart) -> StackedBar:
  return [stackedBar for stackedBar in bar.stackedBars if stackedBar.x == x][0]

def mkBarChart(scenName: str, table: list[Emission]) -> BarChart:
  return BarChart(
    caption="Scenario " + scenName,
    size=Dimensions(width=275, height=185),
    tickLabels=TickLabels(x=Default(), y=Default()),
    stackedBars=
      [StackedBar(x=record.type, segments=[Segment(y="emissions", z=record.emissions)]) for record in table],
    legend=True
  )

def mkHistogram(xs: list[float], name: str, nbins: int) -> BarChart:
  binWidth: float = (maximum(xs) - minimum(xs)) / nbins

  return BarChart(
    caption="Histogram of distribution of " + name,
    size=Dimensions(width=275, height=185),
    tickLabels=TickLabels(x=Default(), y=Default()),
    stackedBars=
      [StackedBar(x=num_to_str(edge), segments=[Segment(y="density", z=len(data) / binWidth)]) for (data, edge) in cut(xs, nbins)],
    legend=True
  )

def getHeight(offset: float, bar: StackedBar) -> float:
  return bar.segments[0].z + offset

changed126: list[float] = [r.changed for r in ssp126preds]
changed245: list[float] = [r.changed for r in ssp245preds]
ssp126Total: Emission = Emission("Total", fsum([r.emissions for r in ssp126Source]))
ssp126table: list[Emission] = [ssp126Total] + ssp126Source
ssp245table: list[Emission] = [Emission("Total", find_percentile(50, changed245))] + ssp245Source
ssp126: BarChart = mkBarChart("SSP1-2.6", ssp126table)
ssp245: BarChart = mkBarChart("SSP2-4.5", ssp245table)
totals: list[float] = map(stackedBarHeight, map(get("Total"), [ssp126, ssp245]))
co2s: list[float] = map(stackedBarHeight, map(get("CO2"), [ssp126, ssp245]))
nonco2: list[StackedBar] = map(get("Non-CO2"), [ssp126, ssp245])

MultiView([
  ssp126,
  ssp245,
  f"""Within each scenario bar plot, the bars represent: {Link(totals, "total warming (°C)")},
      {Link(co2s, "warming from CO2 (°C)")} and from
      {Link(map(stackedBarHeight, nonco2), "Non-CO2 GHG's (°C)")}."""
])
