from fluid.stats import find_percentile, cut
from figure4b_data import ssp126Source, ssp126preds, ssp245Source, ssp245preds

from fluid.view import BarChart, MultiView, Default, Link

def stackedBarHeight(stackedBar):
  return sum([segment["z"] for segment in stackedBar["segments"]])

def get(x, bar):
  return from_just(find_with_key("x", x, bar.stackedBars))

def mkBarChart(scenName, table):
  return BarChart(
    caption="Scenario " ++ scenName,
    size={ width: 275, height: 185 },
    tickLabels={ x: Default, y: Default },
    stackedBars=
      map(lambda record: {
        x: record["type"],
        segments: [{ y: "emissions", z: record["emissions"] }]
      }, table),
    legend=True
  )

def mkHistogram(xs, name, nbins):
  binWidth = (maximum(xs) - minimum(xs)) / nbins

  return BarChart(
    caption="Histogram of distribution of " ++ name,
    size={ width: 275, height: 185 },
    tickLabels={ x: Default, y: Default },
    stackedBars=
      map(lambda (data, edge): {
        x: data,
        segments: [{ y: "density", z: length(data) / binWidth }]
      }, cut(xs, nbins)),
    legend=True
  )

def getHeight(offset, bar):
  return head(bar["segments"])["z"] + offset

changed126 = map(lambda r: r["changed"], ssp126preds)
changed245 = map(lambda r: r["changed"], ssp245preds)
ssp126Total = { type: "Total", emissions: sum(map(lambda r: r["emissions"], ssp126Source)) }
ssp126table = ssp126Total :| ssp126Source
ssp245table = { type: "Total", emissions: find_percentile(50, changed245) } :| ssp245Source
ssp126 = mkBarChart("SSP1-2.6", ssp126table)
ssp245 = mkBarChart("SSP2-4.5", ssp245table)
totals = map(stackedBarHeight, map(get("Total"), [ssp126, ssp245]))
co2s = map(stackedBarHeight, map(get("CO2"), [ssp126, ssp245]))
nonco2 = map(get("Non-CO2"), [ssp126, ssp245])

MultiView([
  ssp126,
  ssp245,
  f"""Within each scenario bar plot, the bars represent: {Link(totals, "total warming (°C)")} ,
      {Link(co2s, "warming from CO2 (°C) ")} and from
      {Link(map(stackedBarHeight, nonco2), "Non-CO2 GHG's (°C)")}."""
])
