from math import ceil
from nap3_ccra3_data import nap3_actions, ccra3_risks

from fluid.view import BarChart, MultiView, Default, Rotated, Link

eval_scores = [ "Significantly addressed", "Recognised but not addressed",
    "Not addressed", "Minimally addressed", "Fully addressed" ]

def actions_by(key, keys):
  return [ { x: key_,
      segments: [
        { y: eval_score,
          z: count_if(
            lambda action:
              action[ key ] == key_ and action[ "Evaluation score" ] == eval_score,
            nap3_actions
          ) } for eval_score in eval_scores
      ] } for key_ in keys
  ]

risks_ = pairs_to_dict([ (r[ "ID#" ], r) for r in ccra3_risks ])

actions_by_chapter = [ { x: chapter,
      segments: [
        { y: eval_score,
          z: count_if(
            lambda action:
              risks_[ action[ "Risk ID#" ] ][ "Chapter" ] == chapter and
              action[ "Evaluation score" ] == eval_score,
            nap3_actions
          ) } for eval_score in eval_scores
      ] } for chapter in [ "3", "4", "5", "6", "7" ]
  ]

departments = [ "DBT", "DCMS", "Defra", "DESNZ", "DfT", "DHSC", "DLUHC", "DSIT", "FCDO", "HMT", "MoJ" ]

nat_env_and_infra_depts = [ "Defra", "DESNZ", "DfT", "DLUHC" ]

by_action_owner = actions_by("Action Owner", departments)

by_topology = actions_by(
    "Typology",
    [ "No and low regret adaptation, including capacity building",
      "Climate-smart design, considering uncertainty",
      "Further investigation",
      "Early activities to support future adaptation",
      "Unclear typology noted in text" ]
  )

# action_counts in the [ { y, z } ] format produced by actions_by
def total_actions(action_counts):
  return sum([ r["z"] for r in action_counts ])

def actions_with_score(action_counts, eval_score):
  return sum([ r["z"] for r in action_counts if r["y"] == eval_score ])

def proportion(x, y):
  return 0 if y == 0 else x / y

def max_with_score(actions, eval_score):
  return maximum([
    proportion(actions_with_score(action_counts, eval_score), total_actions(action_counts))
    for { segments: action_counts } in actions
  ])

by_nat_env_and_infra = actions_by("Action Owner", nat_env_and_infra_depts)

MultiView([
  f"""
  Climate Change Risk Assessment (CCRA3) identified {
    length(nub([ risk[ "Risk or Opportunity Descriptor" ] for risk in ccra3_risks ]))
  } risks/opportunities for the UK;
  this report evaluates extent to which NAP3 commitments actually address them.
  """,
  BarChart(
    caption="NAP3 actions by chapter",
    size={ width: 275, height: 185 },
    tickLabels={ x: Default, y: Default },
    stackedBars=actions_by_chapter,
    legend=False
  ),
  BarChart(
    caption="NAP3 actions by government department",
    tickLabels={ x: Rotated, y: Default },
    size={ width: 275, height: 200 },
    stackedBars=by_action_owner,
    legend=True
  ),
  f"""
  Disaggregating by department revealed marked disparities in government response. {
    Link(nat_env_and_infra_depts, "Natural environment and infrastructure sectors")
  } performed relatively well, with {
    sum([
      actions_with_score(action_counts, eval_score)
      for eval_score in [ "Fully addressed", "Minimally addressed" ]
      for { segments: action_counts } in by_nat_env_and_infra
    ])
  } of {
    sum([ total_actions(action_counts) for { segments: action_counts } in by_nat_env_and_infra])
  } actions at least “minimally addressed.”
  In contrast, business and industry actions lagged sharply, with nearly half unaddressed or only nominally
  recognized—an institutional lapse in private-sector resilience. Defra (Environment, Food and Rural Affairs)
  dominated, although only a small portion of were fully or significantly addressed. Departments
  with cross-sectoral mandates such as DSIT (Science & Technology) and HMT (Treasury) had smaller action bases
  and weaker scores. No department had more than {
    ceil(max_with_score(by_action_owner, "Fully addressed") * 100)
  }% of its actions fully addressed, reinforcing the impression of a fragmented governance system where adaptation
  remains siloed and under-resourced.
  """,
  f"""
  Of the {
    Link(
      [ (risk[ "Chapter" ], risk[ "Risk or Opportunity Descriptor" ])
        for risk in ccra3_risks if risk[ "CCC Priority" ] == "Yes"
      ],
      "committee's priority risks"
    )
  }, the distribution also reveals where policy attention is converging. Chapters 3 and 4 (Nature and
  Infrastructure) contain the densest clusters of actions, suggesting that physical-system adaptation still
  dominates the UK’s climate agenda. By contrast, social, business, and interdependency-related risks—those
  demanding coordination across institutions or behavioural change—show thinner coverage and weaker evaluation
  scores.
  """
])
