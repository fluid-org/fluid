from methane_data import methane

from fluid.view import Dimensions, LineChart, LinePlot, Point, TickLabels, Default, Rotated

def series(type):
  return [Point(row["year"], row["emissions"]) for row in methane if row["type"] == type]

LineChart(
  size=Dimensions(450, 285),
  tickLabels=TickLabels(Rotated, Default),
  caption=
    "Sources of methane emissions for Africa and the Middle East (IPCC AR6)",
  plots=
    [LinePlot(name=type, points=series(type)) for type in [
      "Agricultural Waste Burning",
      "Agriculture",
      "Energy Sector",
      "Forest Burning",
      "Grassland Burning",
      "Industrial Sector",
      "Residential Commercial Other",
      "Transportation Sector",
      "Waste"
    ]]
)
