def insert(lt, x, ys):
  def go(i):
    if i == len(ys) or x |lt| ys[i]:
      return take(i, ys) + [x] + drop(i, ys)
    return go(i + 1)
  return go(0)

def insertionSort(lt, lst):
  return foldl(lambda sorted, x: insert(lt, x, sorted), [], lst)

def findIndex(fName, x, ys):
  def go(i):
    if i == len(ys):
      return -1
    if ys[i][fName] == x:
      return i + 1
    return go(i + 1)
  return go(0)

def find_with_key_(fName, x, table):
  return [r for r in table if r[fName] == x][0]

def findWhere(pred, table):
  return [r for r in table if pred(r)][0]

def model(m, t):
  return find_with_key_("model", m, t)

def maximumBy(f, xs):
  return foldl(lambda current, y: y if f(y) > f(current) else current, xs[0], tail(xs))
