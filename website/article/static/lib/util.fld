def insert(lt, x, ys):
  if len(ys) == 0:
    return [x]
  if x |lt| ys[0]:
    return [x] + ys
  return [ys[0]] + insert(lt, x, tail(ys))

def insertionSort(lt, lst):
  return foldl(lambda sorted, x: insert(lt, x, sorted), [], lst)

def findIndex(fName, x, ys):
  def go(i):
    if i == len(ys):
      return -1
    if ys[i][fName] == x:
      return i + 1
    return go(i + 1)
  return go(0)

def find_with_key_(fName, x, table):
  return from_just(find_with_key(fName, x, table))

def findWhere(pred, table):
  return from_just(find(pred, table))

def model(m, t):
  return find_with_key_("model", m, t)

def maximumBy(f, xs):
  return foldl(lambda current, y: y if f(y) > f(current) else current, xs[0], tail(xs))
