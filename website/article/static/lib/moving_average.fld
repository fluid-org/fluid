from methane_data import methane

from fluid.view import Dimensions, LineChart, LinePlot, Point, TickLabels, Default, Rotated

def nthPad(n, xs):
  return xs[min(max(n, 0), len(xs) - 1)]
def movingAvg(ys, window):
  return [sum([nthPad(n, ys) for n in range(i - window, i + window + 1)]) / (1 + 2 * window) for i in range(0, len(ys))]
def movingAvg_(rs, window):
  return zip_with(lambda x, y: Point(x, y), map(lambda p: p.x, rs), movingAvg(map(lambda p: p.y, rs), window))

points = [Point(x=r["year"], y=r["emissions"]) for r in methane if r["type"] == "Agriculture"]

LineChart(
  tickLabels=TickLabels(x=Rotated(), y=Default()),
  size=Dimensions(width=330, height=285),
  caption="SSP5-8.5 projected methane emissions (Agriculture)",
  plots=[
    LinePlot(
      name="Moving average",
      points=movingAvg_(points, 1)
    ),
    LinePlot(name="Original curve", points=points)
  ]
)
