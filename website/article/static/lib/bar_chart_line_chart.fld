from renewables import renewables

from fluid.view import BarChart, Dimensions, LineChart, MultiView, LinePlot, Point, Segment, StackedBar, TickLabels, Default

def totalFor(c, rows):
  return sum([row["output"] for row in rows if row["country"] == c])

data2015 = [row for row in renewables if row["year"] == 2015]
countryData = [StackedBar(c, [Segment("output", totalFor(c, data2015))]) for c in ["China", "USA", "Germany"]]

def series(energyType, country):
  return [
    Point(row["year"], row["output"])
    for year in range(2013, 2019) for row in renewables
    if row["year"] == year if row["energyType"] == energyType if row["country"] == country
  ]

MultiView([
  BarChart(
    caption="Total renewables output by country",
    size=Dimensions(275, 185),
    tickLabels=TickLabels(Default, Default),
    stackedBars=countryData,
    legend=True
  ),
  LineChart(
    tickLabels=TickLabels(Default, Default),
    size=Dimensions(330, 285),
    caption="Renewables output of USA relative to China",
    plots=[
     LinePlot(
       name=energyType,
       points=zip_with(lambda p1, p2: Point(p1.x, p1.y / p2.y), usa, china)
     )
     for energyType in ["Bio", "Hydro", "Solar", "Wind"]
     for (usa, china) in [(series(energyType, "USA"), series(energyType, "China"))]
   ]
 )
])
