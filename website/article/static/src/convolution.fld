import fluid.view
from fluid.prelude import sum

inputImage: Matrix[int] = @doc("inputImage") [| [
    [15, 13, 6, 9, 16],
    [12, 5, 15, 4, 13],
    [14, 9, 20, 8, 1],
    [4, 10, 3, 7, 19],
    [3, 11, 15, 2, 9]
  ][i][j] for (i, j) in (5, 5) |]

filter: Matrix[int] = @doc("filter") [| [
    [-2, -1, 0],
    [-1, 1, 1],
    [0, 1, 2]
  ][i][j] for (i, j) in (3, 3) |]

def lookup(m: int, n: int, image: Matrix[int]) -> int:
  m_size, n_size = dims(image)
  if (m >= 0 and m < m_size) and (n >= 0 and n < n_size):
    return image[m, n]
  else:
    return 0 # pad with zeros

def matrix_sum(matr: Matrix[int]) -> int:
  m, n = dims(matr)
  return sum([matr[i, j] for i in range(0, m) for j in range(0, n)])

def convolve(image: Matrix[int], kernel: Matrix[int]) -> Matrix[int]:
  k_i, k_j = dims(kernel)
  half_i, half_j = k_i |quot| 2, k_j |quot| 2

  def inter_matrix(m: int, n: int) -> Matrix[int]:
    return @doc(f"""average these to compute element ({m}, {n})""")
      [| lookup(m + i - half_i, n + j - half_j, image) * kernel[i, j]
         for (i, j) in (k_i, k_j) |]

  return [| matrix_sum(inter_matrix(m, n)) |quot| k_i * k_j for (m, n) in dims(image) |]

convolve(inputImage, filter)
