from typing import Callable
from dataclasses import dataclass
from math import floor
from fluid.prelude import ceil_to_nearest, compose, curry, fmax, foldl, log_base, map, prod, scanl, snd, tail, zip

type Colour = str
type Colours = list[Colour]
type Cat = str

@dataclass
class Point:
  x: float
  y: float

@dataclass
class Orient:
  pass

@dataclass
class Horiz(Orient):
  pass

@dataclass
class Vert(Orient):
  pass

@dataclass
class GraphicsElement:
  pass

@dataclass
class Circle(GraphicsElement):
  x: float
  y: float
  radius: float
  fill: str

@dataclass
class Group(GraphicsElement):
  children: list[GraphicsElement]

@dataclass
class Line(GraphicsElement):
  p1: Point
  p2: Point
  stroke: str
  strokeWidth: float

@dataclass
class Polyline(GraphicsElement):
  points: list[Point]
  stroke: str
  strokeWidth: float

@dataclass
class Polymarkers(GraphicsElement):
  points: list[Point]
  markers: list[GraphicsElement]

@dataclass
class Rect(GraphicsElement):
  x: float
  y: float
  width: float
  height: float
  fill: str

# SVG text-anchor and alignment-baseline properties
@dataclass
class String(GraphicsElement):
  x: float
  y: float
  str: str
  anchor: str
  baseline: str

@dataclass
class Transform:
  pass

@dataclass
class Scale(Transform):
  x: float
  y: float

@dataclass
class Translate(Transform):
  x: float
  y: float

# Margin is in parent reference frame; scaling applies to translated coordinates.
@dataclass
class Viewport(GraphicsElement):
  x: float
  y: float
  width: float
  height: float
  fill: str
  margin: float
  scale: Transform
  translate: Transform
  g: GraphicsElement

@dataclass
class Marker:
  pass

@dataclass
class Arrowhead(Marker):
  pass

# Group has location (0, 0) because it doesn't interfere with positioning of its children.
def coords(Group(gs): GraphicsElement) -> Point:
  return Point(0, 0)
def coords(Rect(x, y, _, _, _): GraphicsElement) -> Point:
  return Point(x, y)
def coords(String(x, y, _, _, _): GraphicsElement) -> Point:
  return Point(x, y)
def coords(Viewport(x, y, _, _, _, _, _, _, _): GraphicsElement) -> Point:
  return Point(x, y)

def get_x(g: GraphicsElement) -> float:
  Point(x, _) = coords(g)
  return x

def get_y(g: GraphicsElement) -> float:
  Point(_, y) = coords(g)
  return y

# Want some kind of typeclass mechanism plus record accessors/updaters.
def set_x(x: float, Group(gs): GraphicsElement) -> GraphicsElement:
  assert False, "Group has immutable coordinates"
def set_x(x: float, Rect(_, y, w, h, fill): GraphicsElement) -> GraphicsElement:
  return Rect(x=x, y=y, width=w, height=h, fill=fill)
def set_x(x: float, String(_, y, str, anchor, baseline): GraphicsElement) -> GraphicsElement:
  return String(x, y, str, anchor, baseline)
def set_x(x: float, Viewport(_, y, w, h, fill, margin, scale, translate, g): GraphicsElement) -> GraphicsElement:
  return Viewport(x=x, y=y, width=w, height=h, fill=fill, margin=margin, scale=scale, translate=translate, g=g)

def dimensions2((Point(x1, y1), Point(x2, y2)): tuple[Point, Point]) -> Point:
  return Point(fmax(x1, x2), fmax(y1, y2))

# For Group, dimensions are relative to implicit coords of (0, 0), since a Group's children are effectively
# positioned relative to parent of Group. For Polymarker, will probably have to ignore the markers themselves,
# since they are scale-invariant.
def dimensions(Group(gs): GraphicsElement) -> Point:
  return foldl(curry(dimensions2), Point(0, 0), map(coords_op, gs))
def dimensions(Polyline(ps, _, _): GraphicsElement) -> Point:
  return foldl(curry(dimensions2), Point(0, 0), ps)
def dimensions(Rect(_, _, w, h, _): GraphicsElement) -> Point:
  return Point(w, h)
def dimensions(String(_, _, _, _, _): GraphicsElement) -> Point:
  return Point(0, 0)
def dimensions(Viewport(_, _, w, h, _, _, _, _, _): GraphicsElement) -> Point:
  return Point(w, h)

def coords_op(g: GraphicsElement) -> Point:
  (Point(x, y), Point(w, h)) = prod(coords, dimensions, g)
  return Point(x + w, y + h)

def width(g: GraphicsElement) -> float:
  Point(w, _) = dimensions(g)
  return w

def height(g: GraphicsElement) -> float:
  Point(_, h) = dimensions(g)
  return h

def space_right(z: float, sep: float, gs: list[GraphicsElement]) -> list[GraphicsElement]:
  return [set_x(z + sep * i, gs[i]) for i in range(0, len(gs))]

# Bake colour decisions into the library for the time being. Provide two palettes, so we can have two
# different sets of categorical values (e.g. countries and energy types). Palettes from colorbrewer2.org
colours1: Colours = [
  "#66c2a5",
  "#a6d854",
  "#ffd92f",
  "#e5c494",
  "#fc8d62",
  "#b3b3b3",
  "#8da0cb",
  "#e78ac3"
]

colours2: Colours = [
  "#e41a1c",
  "#377eb8",
  "#4daf4a",
  "#984ea3",
  "#ff7f00",
  "#ffff33",
  "#a65628",
  "#f781bf"
]

# Compositionality principle: child coords/dimensions are always expressed directly using parent reference
# frame, to avoid depending on content of child, and so are not themselves scaled. Polyline can't be scaled
# directly because it inherits its frame of reference from its parent. For Viewport, margin will shrink the
# available area, possibly to zero, at which point nothing will be rendered.
def scale_to_width(w: float, Rect(x, y, _, h, fill): GraphicsElement) -> GraphicsElement:
  return Rect(x=x, y=y, width=w, height=h, fill=fill)
def scale_to_width(w: float, Viewport(x, y, w0, h, fill, margin, Scale(x_scale, y_scale), translate, g): GraphicsElement) -> GraphicsElement:
  scale: Scale = Scale((x_scale * w) / w0, y_scale)
  return Viewport(x=x, y=y, width=w, height=h, fill=fill, margin=margin, scale=scale, translate=translate, g=g)

def stack_right(sep: float, gs: list[GraphicsElement]) -> list[GraphicsElement]:
  return map(scale_to_width(1 - sep), space_right(sep / 2, 1, gs))

def group_right(sep: float, gs: list[GraphicsElement]) -> GraphicsElement:
  return Viewport(x=0, y=0, width=len(gs), height=max(map(height, gs)), fill="none", margin=0, scale=Scale(1, 1), translate=Translate(0, 0), g=Group(stack_right(sep, gs)))

# Heuristic saying how often to place a tick on an axis of length n.
def tick_every(n: float) -> float:
  m: int = floor(log_base(10, n))

  if n <= 2 * 10 ** m:
    return 2 * 10 ** (m - 1)
  return 10 ** m

axis_stroke_width: float = 0.5
axis_colour: Colour = "black"
background_colour: Colour = "white"
default_margin: float = 24
marker_radius: float = 3.5
tick_length: float = 4

# Helpers for axis functions.
def tick(Horiz(): Orient, colour: Colour, len: float) -> GraphicsElement:
  return Line(Point(0, 0), Point(0, 0 - len), colour, axis_stroke_width)
def tick(Vert(): Orient, colour: Colour, len: float) -> GraphicsElement:
  return Line(Point(0, 0), Point(0 - len, 0), colour, axis_stroke_width)

def label(Horiz(): Orient, x: float, distance: float, str: str) -> GraphicsElement:
  return String(x, (0 - distance) - 4, str, "middle", "hanging")
def label(Vert(): Orient, x: float, distance: float, str: str) -> GraphicsElement:
  return String(0 - distance, x, str, "end", "central")

def labelled_tick(orient: Orient, colour: Colour, len: float, str: str) -> GraphicsElement:
  return Group([
    tick(orient, colour, len),
    label(orient, 0, len, str)
  ])

def mk_point(Horiz(): Orient, x: float, y: float) -> Point:
  return Point(y, x)
def mk_point(Vert(): Orient, x: float, y: float) -> Point:
  return Point(x, y)

# x is position of this axis on the other axis. Returns axis and position of last tick.
def axis(orient: Orient, x: float, start: float, end: float) -> tuple[GraphicsElement, float]:
  tick_sp: float = tick_every(end - start)
  first_tick: float = ceil_to_nearest(start, tick_sp)
  last_tick: float = ceil_to_nearest(end, tick_sp)
  n: int = floor((end - first_tick) / tick_sp) + 1
  ticks: list[float] = [first_tick + tick_sp * i for i in range(0, n)]
  ticks_from_start: list[float] = [start] + ticks if first_tick > start else ticks
  ys: list[float] = ticks_from_start + [last_tick] if last_tick > end else ticks_from_start
  ps: list[Point] = map(mk_point(orient, x), ys)
  ax: GraphicsElement = Group([
      Line(ps[0], ps[-1], axis_colour, axis_stroke_width),
      Polymarkers(ps, map(compose(labelled_tick(orient, axis_colour, tick_length), num_to_str), ys))
    ])

  return ax, last_tick

# x is position of this axis on the other axis.
def cat_axis(orient: Orient, x: float, cat_values: list[Cat]) -> GraphicsElement:
  ps: list[Point] = [mk_point(orient, x, y) for y in range(0, len(cat_values) + 1)]

  return Group([
    Line(ps[0], ps[-1], axis_colour, axis_stroke_width),
    Polymarkers(tail(ps), [tick(orient, axis_colour, tick_length) for _ in cat_values]),
    Polymarkers([Point(x - 0.5, y) for Point(x, y) in tail(ps)], map(label(orient, -0.5, 0), cat_values))
  ])

def viewport(x_start: float, x_finish: float, y_finish: float, margin: float, gs: list[GraphicsElement]) -> GraphicsElement:
  return Viewport(x=0, y=0, width=x_finish - x_start, height=y_finish, fill=background_colour, margin=margin, scale=Scale(1, 1), translate=Translate(0 - x_start, 0), g=Group(gs))

# Plot a map of x values to lists of (categorical value, y value) pairs. Importantly, assume all data is uniform
# (categorical keys are the same for each x value and are ordered the same each time).
def line_chart(with_axes: bool, colours: Colours, x_start: float, data: list[tuple[float, list[tuple[Cat, float]]]]) -> GraphicsElement:
  xs: list[float] = [x for (x, _) in data]
  n_cat: int = len(snd(data[0]))

  def plot(n: int, colour: Colour) -> GraphicsElement:
    ps: list[Point] = [Point(x, snd(kvs[n])) for (x, kvs) in data]

    return Group([
      Polyline(ps, colour, 1),
      Polymarkers(ps, [Circle(x=0, y=0, radius=marker_radius, fill=colour) for _ in ps])
    ])

  lines: list[GraphicsElement] = [plot(n, colours[n]) for n in range(0, n_cat)]
  x_finish: float = xs[-1]
  y_finish: float = max([max([v for (_, v) in kvs]) for (_, kvs) in data])

  if with_axes:
    x_axis, x_finish_ = axis(Horiz(), 0, x_start, x_finish)
    y_axis, y_finish_ = axis(Vert(), x_start, 0, y_finish)
    return viewport(x_start, x_finish_, y_finish_, default_margin, [x_axis, y_axis] + lines)
  return viewport(x_start, x_finish, y_finish, 0, lines)

# Plot a chart of categorical values on the x-axis and renderings of the corresponding a-value on the y-axis.
def categorical_chart[A](plot_value: Callable[[Colours, list[A]], list[GraphicsElement]], with_axes: bool, colours: Colours, sep: float, data: list[tuple[Cat, A]]) -> GraphicsElement:
  gs: list[GraphicsElement] = stack_right(sep, plot_value(colours, [kvs for (_, kvs) in data]))
  w: int = len(gs)
  h: float = max(map(height, gs))

  if with_axes:
    x_axis: GraphicsElement = cat_axis(Horiz(), 0, [x for (x, _) in data])
    y_axis, h_ = axis(Vert(), 0, 0, h)
    return viewport(0, w, h_, default_margin, gs + [x_axis, y_axis])
  return viewport(0, w, h, 0, gs)

def rects(colours: Colours, ns: list[float]) -> list[GraphicsElement]:
  return [Rect(x=0, y=0, width=1, height=n, fill=colour) for (colour, n) in zip(colours, ns)]

# First component of data (categorical value) currently ignored; values just mapped positionally to colors.
# Can we use Group instead of Viewport here?
def stacked_bar(colours: Colours, ns: list[tuple[Cat, float]]) -> GraphicsElement:
  heights: list[float] = [h for (_, h) in ns]
  subtotals: list[float] = scanl(lambda x, y: x + y, 0.0, heights)
  dims: list[tuple[float, float]] = zip(subtotals, heights)
  bars: list[GraphicsElement] = [Rect(x=0, y=y, width=1, height=height, fill=colour) for ((y, height), colour) in zip(dims, colours)]

  return Viewport(x=0, y=0, width=1, height=subtotals[-1], fill="none", margin=0, scale=Scale(1, 1), translate=Translate(0, 0), g=Group(bars))

bar_chart: Callable[[bool, Colours, float, list[tuple[Cat, float]]], GraphicsElement] = categorical_chart(rects)

# For each categorical value, plot a bar chart for the corresponding data.
def grouped_bar_chart(with_axes: bool, colours: Colours, sep: float, data: list[tuple[Cat, list[tuple[Cat, float]]]]) -> GraphicsElement:
  return categorical_chart(lambda colours_, groups: [bar_chart(False, colours_, 0, group) for group in groups], with_axes, colours, sep, data)

# See stacked_bar for strong (unjustified) assumption about uniformity of data.
def stacked_bar_chart(with_axes: bool, colours: Colours, sep: float, data: list[tuple[Cat, list[tuple[Cat, float]]]]) -> GraphicsElement:
  return categorical_chart(lambda colours_, groups: map(stacked_bar(colours_), groups), with_axes, colours, sep, data)

# Bit of a hack, but how text fits into our model is a bit unclear at the moment.
def caption(str: str, Viewport(x, y, w, h, fill, margin, scale, translate, g): GraphicsElement) -> GraphicsElement:
  g_: GraphicsElement = Group([
      String(x + w / 2, -2, str, "middle", "hanging"),
      Viewport(x=0, y=0, width=w, height=h, fill=fill, margin=margin, scale=scale, translate=translate, g=g)
    ])

  return Viewport(x=x, y=y, width=w, height=h, fill=background_colour, margin=default_margin / 2 + 4, scale=Scale(1, 1), translate=Translate(0, 0), g=g_)
