from dataclasses import dataclass

@dataclass
class Orientation:
  pass

@dataclass
class Default(Orientation):
  pass

@dataclass
class Rotated(Orientation):
  pass

@dataclass
class Scale:
  pass

@dataclass
class Auto(Scale):
  pass

@dataclass
class FromZero(Scale):
  pass

@dataclass
class Fixed(Scale):
  min: float
  max: float

@dataclass
class Scales:
  x: Scale
  y: Scale

@dataclass
class TickSpacing:
  pass

@dataclass
class AutoTicks(TickSpacing):
  pass

@dataclass
class Count(TickSpacing):
  n: int

@dataclass
class Every(TickSpacing):
  step: float

@dataclass
class LabelFormat:
  pass

@dataclass
class AutoFormat(LabelFormat):
  pass

@dataclass
class Decimals(LabelFormat):
  places: int

@dataclass
class AxisTicks:
  spacing: TickSpacing
  format: LabelFormat

@dataclass
class Ticks:
  x: AxisTicks
  y: AxisTicks

default_ticks: Ticks = Ticks(x=AxisTicks(AutoTicks(), AutoFormat()), y=AxisTicks(AutoTicks(), AutoFormat()))

@dataclass
class Dimensions:
  width: int
  height: int

@dataclass
class Point:
  x: float
  y: float

@dataclass
class AxisLabels:
  x: str
  y: str

@dataclass
class TickLabels:
  x: Orientation
  y: Orientation

@dataclass
class Segment:
  y: str
  z: float

@dataclass
class StackedBar:
  x: str
  segments: list[Segment]

@dataclass
class LinePlot:
  name: str
  points: list[Point]

@dataclass
class View:
  pass

@dataclass
class BarChart(View):
  caption: str
  size: Dimensions
  tickLabels: TickLabels
  stackedBars: list[StackedBar]
  legend: bool

@dataclass
class LineChart(View):
  size: Dimensions
  tickLabels: TickLabels
  caption: str
  scales: Scales
  ticks: Ticks
  plots: list[LinePlot]

@dataclass
class MultiView(View):
  views: list[object]

@dataclass
class Paragraph(View):
  fragments: list[object]

@dataclass
class ScatterPlot(View):
  caption: str
  points: list[Point]
  labels: AxisLabels

@dataclass
class ParaFragment:
  pass

@dataclass
class Text(ParaFragment):
  text: str

@dataclass
class Link(ParaFragment):
  value: object
  label: str
