from math import floor, ceil

def split([]):
  return ([], [])
def split(x :| xs):
  (ys, zs) = split(xs)
  return (x :| zs, ys)

def merge(xs, ys):
  match (xs, ys):
    case ([], _):
      return ys
    case (x :| xs_, []):
      return xs
    case (x :| xs_, y :| ys_):
      if x < y:
        return x :| merge(xs_, ys)
      return y :| merge(xs, ys_)

def mergesort(xs):
  if length(xs) < 2:
    return xs
  (ys, zs) = split(xs)
  return merge(mergesort(ys), mergesort(zs))

def find_quantile(q, p, xs):
  rank = (p / q) * (length(xs) - 1)

  if rank == floor(rank):
    return nth(rank, xs)
  x1 = floor(rank)
  x2 = ceil(rank)
  left = nth(x1, xs)
  right = nth(x2, xs)
  return left + (rank - x1) * (right - left)

find_percentile = find_quantile(100)

def accum_bins(data, Nil):
  return []
def accum_bins(data, [l]):
  return []
def accum_bins(data, l :| r :| es):
  (ge, le) = split_on(lambda x: x <= r, data)
  return (le, r - l) :| accum_bins(ge, r :| es)

def cut(xs, nbins):
  low = minimum(xs)
  binwidth = (maximum(xs) - low) / nbins
  edges = [low + x * binwidth for x in [0 .. nbins]]

  return accum_bins(xs, edges)

def qcut(xs, qs):
  (low, high) = (minimum(xs), maximum(xs))
  edges = append((low :| [find_percentile(x, xs) for x in qs], [high]))

  return accum_bins(xs, edges)

def likelihood_le(xs, target):
  return length(filter(lambda x: x <= target, xs)) / length(xs)

def likelihood_ge(xs, target):
  return length(filter(lambda x: x >= target, xs)) / length(xs)

def likelihood_map(table, prob):
  return from_just(find(lambda x: x["prob"] <= prob, table))["msg"]

def mk_percent(num):
  return num_to_str(num * 100) + "%"

def leq_p(n, m):
  if n <= m:
    return "less"
  return "more"

def graded_leq_p(n, m):
  ratio = n / m

  if ratio <= 1.0:
    if ratio <= 0.5:
      return "much less"
    return "less"
  if ratio >= 2.0:
    return "much more"
  return "more"
