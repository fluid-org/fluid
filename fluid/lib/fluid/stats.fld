from math import floor, ceil

def split(xs):
  return ([xs[i] for i in range(0, len(xs)) if i % 2 == 0], [xs[i] for i in range(0, len(xs)) if i % 2 == 1])

def merge(xs, ys):
  if len(xs) == 0:
    return ys
  if len(ys) == 0:
    return xs
  if xs[0] < ys[0]:
    return [xs[0]] + merge(tail(xs), ys)
  return [ys[0]] + merge(xs, tail(ys))

def mergesort(xs):
  if len(xs) < 2:
    return xs
  (ys, zs) = split(xs)
  return merge(mergesort(ys), mergesort(zs))

def find_quantile(q, p, xs):
  rank = (p / q) * (len(xs) - 1)

  if rank == floor(rank):
    return nth(rank, xs)
  x1 = floor(rank)
  x2 = ceil(rank)
  left = nth(x1, xs)
  right = nth(x2, xs)
  return left + (rank - x1) * (right - left)

find_percentile = find_quantile(100)

def accum_bins(data, edges):
  if len(edges) < 2:
    return []
  (ge, le) = split_on(lambda x: x <= edges[1], data)
  return [(le, edges[1] - edges[0])] + accum_bins(ge, tail(edges))

def cut(xs, nbins):
  low = minimum(xs)
  binwidth = (maximum(xs) - low) / nbins
  edges = [low + x * binwidth for x in range(0, nbins + 1)]

  return accum_bins(xs, edges)

def qcut(xs, qs):
  (low, high) = (minimum(xs), maximum(xs))
  edges = [low] + [find_percentile(x, xs) for x in qs] + [high]

  return accum_bins(xs, edges)

def likelihood_le(xs, target):
  return len(filter(lambda x: x <= target, xs)) / len(xs)

def likelihood_ge(xs, target):
  return len(filter(lambda x: x >= target, xs)) / len(xs)

def likelihood_map(table, prob):
  return from_just(find(lambda x: x["prob"] <= prob, table))["msg"]

def mk_percent(num):
  return num_to_str(num * 100) + "%"

def leq_p(n, m):
  if n <= m:
    return "less"
  return "more"

def graded_leq_p(n, m):
  ratio = n / m

  if ratio <= 1.0:
    if ratio <= 0.5:
      return "much less"
    return "less"
  if ratio >= 2.0:
    return "much more"
  return "more"
