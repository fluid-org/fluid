from typing import Callable
from dataclasses import dataclass
from math import floor, ceil
from fluid.prelude import filter, maximum, minimum

@dataclass
class Likelihood:
  prob: float
  msg: str

def find_quantile(q: float, p: float, xs: list[float]) -> float:
  rank: float = (p / q) * (len(xs) - 1)

  if rank == floor(rank):
    return xs[floor(rank)]
  x1: int = floor(rank)
  x2: int = ceil(rank)
  left: float = xs[x1]
  right: float = xs[x2]
  return left + (rank - x1) * (right - left)

def find_percentile(p: float, xs: list[float]) -> float:
  return find_quantile(100, p, xs)

def accum_bins(data: list[float], edges: list[float]) -> list[tuple[list[float], float]]:
  return [([x for x in data if (i == 0 or edges[i] < x) and x <= edges[i + 1]], edges[i + 1] - edges[i]) for i in range(0, len(edges) - 1)]

def cut(xs: list[float], nbins: int) -> list[tuple[list[float], float]]:
  low: float = minimum(xs)
  binwidth: float = (maximum(xs) - low) / nbins
  edges: list[float] = [low + x * binwidth for x in range(0, nbins + 1)]

  return accum_bins(xs, edges)

def qcut(xs: list[float], qs: list[float]) -> list[tuple[list[float], float]]:
  low, high = minimum(xs), maximum(xs)
  edges: list[float] = [low] + [find_percentile(x, xs) for x in qs] + [high]

  return accum_bins(xs, edges)

def likelihood_le(xs: list[float], target: float) -> float:
  return len(filter(lambda x: x <= target, xs)) / len(xs)

def likelihood_ge(xs: list[float], target: float) -> float:
  return len(filter(lambda x: x >= target, xs)) / len(xs)

def likelihood_map(table: list[Likelihood], prob: float) -> str:
  return [x for x in table if x.prob <= prob][0].msg

def mk_percent(num: float) -> str:
  return num_to_str(num * 100) + "%"

def leq_p(n: float, m: float) -> str:
  if n <= m:
    return "less"
  return "more"

def graded_leq_p(n: float, m: float) -> str:
  ratio: float = n / m

  if ratio <= 1.0:
    if ratio <= 0.5:
      return "much less"
    return "less"
  if ratio >= 2.0:
    return "much more"
  return "more"
