from dataclasses import dataclass
from math import ceil, log
from typing import Callable

@dataclass
class List:
  pass

@dataclass
class Nil(List):
  pass

@dataclass
class Cons(List):
  head: object
  tail: List

@dataclass
class Maybe:
  pass

@dataclass
class Nothing(Maybe):
  pass

@dataclass
class Just(Maybe):
  value: object

@dataclass
class Pair:
  fst: object
  snd: object

@dataclass
class Tree:
  pass

@dataclass
class Empty(Tree):
  pass

@dataclass
class NonEmpty(Tree):
  left: Tree
  value: object
  right: Tree

@dataclass
class Ordering:
  pass

@dataclass
class LT(Ordering):
  pass

@dataclass
class EQ(Ordering):
  pass

@dataclass
class GT(Ordering):
  pass

@dataclass
class InfNum:
  pass

@dataclass
class FNum(InfNum):
  value: float

@dataclass
class Infty(InfNum):
  pass

# To resolve in new semantics: expected dependencies don't arise for and/or unless they  make a fresh value.
def and(False: bool, y: bool) -> bool:
  return False
def and(True, True):
  return True
def and(True, False):
  return False

def or(True: bool, y: bool) -> bool:
  return True
def or(False, True):
  return True
def or(False, False):
  return False

def not(True: bool) -> bool:
  return False
def not(False):
  return True

# Int -> Int -> Ordering
def compare(x, y):
  if x > y:
    return GT
  if x < y:
    return LT
  return EQ

# (b -> b -> c) -> (a -> b) -> a -> a -> c
def on(bin_op, prop, x, y):
  return bin_op(prop(x), prop(y))

negate: Callable[[int | float], int | float] = (-)(0)

# Log of x in base y.
def log_base(x: float, y: float) -> float:
  return log(y) / log(x)

def ceil_to_nearest(n: float, m: float) -> float:
  return ceil(n / m) * m

# (b -> c) -> (a -> b) -> a -> c
# Want infix <<<
def compose(f, g, x):
  return f(g(x))

# ((a, b) -> c) -> a -> b -> c
def curry(f, x, y):
  return f((x, y))

# (a -> b -> c) -> (a, b) -> c
def uncurry(f, (x, y)):
  return f(x, y)

# a -> b -> a
def const(x, _):
  return x

# (a -> b) -> (a, c) -> (b, c)
def first(f, (a, c)):
  return (f(a), c)

# (a, b) -> b
def snd((_, y)):
  return y

# (a -> b) -> (c, a) -> (c, b)
def second(f, (c, a)):
  return (c, f(a))

# (a -> b -> c) -> b -> a -> c
def flip(f, x, y):
  return f(y, x)

# (a, b) -> a
def fst((x, _)):
  return x

# a -> a
def id(x):
  return x

# (a -> b) -> (a -> c) -> a -> (b, c)
# Want infix &&&
def prod(f, g, x):
  return (f(x), g(x))

# (a, b) -> (b, a)
def swap((a, b)):
  return (b, a)

# List a -> a
def head([]):
  assert False, "Can't take head of empty list"
def head(x :| _):
  return x

# List a -> List a
def tail([]):
  assert False, "Can't take tail of empty list"
def tail(_ :| xs):
  return xs

# Eq a => a -> List a -> Bool
def elem(x, []):
  return False
def elem(x, y :| xs):
  return x == y or elem(x, xs)

# (a -> Bool) -> List a -> Option a
def find(p, []):
  return Nothing
def find(p, x :| xs):
  if p(x):
    return Just(x)
  return find(p, xs)

# String -> String -> List Dict -> Option Dict
def find_with_key(k, v, rs):
  return find(lambda y: y[k] == v, rs)

# Option a -> a
def from_just(Nothing):
  assert False, "Expected Just!"
def from_just(Just(x)):
  return x

# Option a -> a -> a
def from_maybe(Nothing, y):
  return y
def from_maybe(Just(x), _):
  return x

# (a -> Bool) -> List a -> List a
def filter(p, []):
  return []
def filter(p, x :| xs):
  ys = filter(p, xs)

  if p(x):
    return x :| ys
  else:
    return ys

# (a -> Option b) -> List a -> List b
def filter_map(p, []):
  return []
def filter_map(p, x :| xs):
  match p(x):
    case Nothing:
      return filter_map(p, xs)
    case Just(y):
      return y :| filter_map(p, xs)

# Equivalent to but more efficient than length ∘ filter(p)
def count_if(p):
  def f(n, x):
    if p(x):
      return n + 1
    return n
  return foldl(f, 0)

# Split list into longest initial segment whose elements satisfy a predicate, and the rest.
# (a -> Bool) -> List a -> { init :: List a, rest :: List a }
def span(p, Nil):
  return { init: Nil, rest: Nil }
def span(p, x :| xs_):
  if not p(x):
    return { init: Nil, rest: x :| xs_ }
  { init: ys, rest: zs } = span(p, xs_)
  return { init: x :| ys, rest: zs }

# Each returned list is non-empty.
# (a -> a -> Bool) -> List a -> List (List a)
def group_by(eq, Nil):
  return Nil
def group_by(eq, x :| xs):
  { init: ys, rest: zs } = span(eq(x), xs)
  return (x :| ys) :| group_by(eq, zs)

# (a -> b -> a) -> a -> List b -> a
def foldl(op, z, []):
  return z
def foldl(op, z, x :| xs):
  return foldl(op, op(z, x), xs)

# (a -> b -> a) -> List b -> a
def foldl1(op, x :| xs):
  return foldl(op, x, xs)

# (a -> b -> b) -> b -> List a -> b
def foldr(op, z, []):
  return z
def foldr(op, z, x :| xs):
  return op(x, foldr(op, z, xs))

# (a -> b -> b) -> List a -> b
def foldr1(op, [x]):
  return x
def foldr1(op, x :| y :| xs):
  return op(x, foldr1(op, y :| xs))

# (a -> b -> a) -> a -> List b -> List a
def scanl1(op, z, xs):
  def go(x, continue, acc):
    next = op(acc, x)
    return next :| continue(next)
  return foldr(go, const([]), xs, z)

# (a -> b -> a) -> a -> List b -> List a
def scanl(op, z, xs):
  return z :| scanl1(op, z, xs)

# (a -> b) -> List a -> List b
def map(f, []):
  return []
def map(f, x :| xs):
  return f(x) :| map(f, xs)

# (List a, List a) -> List a
def append(([], ys)):
  return ys
def append((x :| xs, ys)):
  return x :| append((xs, ys))

# List a -> List -> List a
# Want infix ++
def concat2([], ys):
  return ys
def concat2(x :| xs, ys):
  return x :| concat2(xs, ys)

# List (List a) -> List a
concat = foldr(concat2, [])

# (a -> List b) -> List a -> List b
def concat_map(f, xs):
  return concat(map(f, xs))

# List String -> String
join = foldr((++), "")

# List a -> a -> List a
def intersperse([], _):
  return []
def intersperse([x], _):
  return [x]
def intersperse(x :| y :| ys, sep):
  return x :| sep :| intersperse(y :| ys, sep)

# Int -> (a -> a) -> a -> List a
def iterate(n, f, z):
  if n == 0:
    return []
  return z :| map(f, iterate(n - 1, f, z))

sum: Callable[[list[int | float]], int | float] = foldr((+), 0)

def mean(xs: list[int | float]) -> float:
  (s, n) = foldl(lambda (s, n), x: (s + x, n + 1), (0, 0), xs)
  return s / n

# List a -> a
def last([x]):
  return x
def last(x :| y :| ys):
  return last(y :| ys)

# List a -> Int
def length([]):
  return 0
def length(_ :| xs):
  return 1 + length(xs)

# List a -> List a
def reverse([]):
  return []
def reverse(x :| xs):
  return append((reverse(xs), [x]))

# Int -> a -> List a
repeat = flip(iterate, id)

# Int -> List a -> List a
def take(n, xs):
  if n <= 0:
    return []
  match xs:
    case []:
      return []
    case x :| xs:
      return x :| take(n - 1, xs)

# Int -> List a -> List a
def drop(n, xs):
  if n <= 0:
    return xs
  match xs:
    case []:
      return []
    case _ :| xs:
      return drop(n - 1, xs)

# Int -> List a -> List a
def last_n(n, xs):
  return foldl(compose(const, drop(1)), xs, drop(n, xs))

# Expects non-negative integer as first argument and non-empty list as second argument.
# Int -> List a -> a
def nth(n, x :| xs):
  if n == 0:
    return x
  return nth(n - 1, xs)

# Int -> Int -> List (List Int) -> Int
def nth2(i, j, xss):
  return nth(j, nth(i, xss))

# Partial; requires k to be in the map.
# Int -> List (Int, b) -> b
def lookup(k, []):
  assert False, "Key not found in map"
def lookup(k, (k_, v) :| kvs):
  if k == k_:
    return v
  return lookup(k, kvs)

# Int -> Int -> Int
def max(n, m):
  return n if n > m else m

# Int -> Int -> Int
def min(n, m):
  return n if n < m else m

# List Int -> Int
maximum = foldr1(max)

# List Int -> Int
minimum = foldr1(min)

# List (a, b) -> (List a, List b)
def unzip([]):
  return ([], [])
def unzip((x, y) :| zs):
  (xs, ys) = unzip(zs)
  return (x :| xs, y :| ys)

# (a -> b -> c) -> List a -> List b -> List c
def zip_with(op, [], ys):
  return []
def zip_with(op, x :| xs, []):
  return []
def zip_with(op, x :| xs, y :| ys):
  return op(x, y) :| zip_with(op, xs, ys)

# List a -> List b -> List (a, b)
zip = zip_with(curry(id))

# Int -> Int -> List Int
def range(n, m):
  if n < m:
    return n :| range(n + 1, m)
  return []

# (Int, Int) -> (Int, Int) -> List (Int, Int)
def range2d((m1, n1), (m2, n2)):
  return [(i1, i2) for i1 in range(m1, m2) for i2 in range(n1, n2)]

# Int -> Int -> Int
def abs(x, y):
  return negate(x - y) if x - y < 0 else x - y

# Eq a => [a] -> [a]
def nub(xs):
  def nub_([], _):
    return []
  def nub_(x :| xs, ys):
    if x |elem| ys:
      return nub_(xs, ys)
    return x :| nub_(xs, x :| ys)

  return nub_(xs, [])

# Int -> Int -> [a] -> [a]
def slice(begin, end, xs):
  return take(end - begin, drop(begin, xs))

# (a -> Boolean) -> List a -> (List a, List a)
def split_on(p, data):
  def go(fls, trs, []):
    return (reverse(fls), reverse(trs))
  def go(fls, trs, x :| xs):
    if p(x):
      return go(fls, x :| trs, xs)
    return go(x :| fls, trs, xs)

  return go([], [], data)
