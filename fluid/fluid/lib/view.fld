@dataclass
class Orientation:
  pass

@dataclass
class Default(Orientation):
  pass

@dataclass
class Rotated(Orientation):
  pass

@dataclass
class LinePlot:
  name: str
  points: list[dict[str, float]]

@dataclass
class View:
  pass

@dataclass
class BarChart(View):
  caption: str
  size: dict[str, int]
  tickLabels: dict[str, Orientation]
  stackedBars: list[dict[str, object]]
  legend: bool

@dataclass
class LineChart(View):
  size: dict[str, int]
  tickLabels: dict[str, Orientation]
  caption: str
  plots: list[LinePlot]

@dataclass
class MultiView(View):
  views: list[View]

@dataclass
class Paragraph(View):
  fragments: list[View]

@dataclass
class ScatterPlot(View):
  caption: str
  points: list[dict[str, float]]
  labels: dict[str, str]

@dataclass
class ParaFragment:
  pass

@dataclass
class Text(ParaFragment):
  text: str

@dataclass
class Link(ParaFragment):
  value: object
  label: str
