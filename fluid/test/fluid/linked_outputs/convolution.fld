from fluid.matrix import zero, wrap, convolve
from linked_outputs.convolution_data import data

filter1_ = [
    [0, 0, 0],
    [3, 7, 1],
    [0, 0, 0]
  ]
filter1 = [| nth2(i, j, filter1_) for (i, j) in (3, 3) |]
image1 = [| nth2(i, j, data) for (i, j) in (5, 5) |]
filter2_ = [
    [0, 2, 0],
    [0, 7, 0],
    [0, 5, 0]
  ]
filter2 = [| nth2(i, j, filter2_) for (i, j) in (3, 3) |]
image2 = [| nth2(i, j, data) for (i, j) in (5, 5) |]

(convolve(image1, filter1, wrap), convolve(image2, filter2, zero))
