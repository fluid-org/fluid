import lib.matrix_doc

# Exercises @doc annotations that live in an imported module (lib.matrix_doc),
# verifying the benchmark harness strips doc comments from libraries. See
# docs/reports/intermediate-perf-notes.md.

inputImage = [| nth2(i, j, [[3, 1, 2], [0, 4, 1], [2, 1, 3]]) for (i, j) in (3, 3) |]
kernel = [| nth2(i, j, [[1, 1, 0], [1, 2, 1], [0, 1, 1]]) for (i, j) in (3, 3) |]

convolve(inputImage, kernel, zero)
