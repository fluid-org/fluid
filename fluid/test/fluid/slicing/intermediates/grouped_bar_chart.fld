import lib.graphics
import dataset.renewables_restricted

year = 2015

def exclude(countries, yearData):
  return flip(map, yearData, second(filter(lambda (country, countryData): not(elem(country, countries)))))

def annotate(yearData):
  return [ @doc(f"""{country}: {sum(map(snd, kvs))} GW across {length(kvs)} energy types""") (country, kvs)
    for (country, kvs) in yearData ]

caption("Renewables (GW) by country and energy type, " ++ num_to_str(year), grouped_bar_chart(True, colours1, 0.2, annotate(exclude([], lookup(year, data)))))
