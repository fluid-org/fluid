from dataset.energy_data import renewables, nonRenewables

from fluid.view import ScatterPlot

def isCountry(name, x):
  return name == x["country"]
def isYear(year, x):
  return year == x["year"]

def plot(year, countries):
  rens = filter(isYear(year), renewables)
  nonRens = filter(isYear(year), nonRenewables)

  def plotCountry(country):
    rens_ = filter(isCountry(country), rens)
    rensOut = sum(map(lambda x: x["output"], rens_))
    rensCap = sum(map(lambda x: x["capacity"], rens_))
    x = head(filter(isCountry(country), nonRens))
    nonRensCap = ((x["nuclearCap"] + x["petrolCap"]) + x["gasCap"]) + x["coalCap"]

    return {
      x: rensCap / (rensCap + nonRensCap),
      y: (rensOut + x["nuclearOut"]) / (rensCap + x["nuclearCap"])
    }

  return map(plotCountry, countries)

ScatterPlot(
  caption="Clean energy efficiency vs. proportion of renewable energy capacity",
  points=plot(2018, [ "BRA", "CHN", "DEU", "FRA", "EGY", "IND", "JPN", "MEX", "NGA", "USA" ]),
  labels={
    x: "Renewables/TotalEnergyCap",
    y: "Clean Capacity Factor"
  }
)
