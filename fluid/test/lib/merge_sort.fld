def split([]):
  return ([], [])
def split(x :| xs):
  (ys, zs) = split(xs)
  return (x :| zs, ys)

def merge(xs, ys):
  match (xs, ys):
    case ([], _):
      return ys
    case (x :| xs_, []):
      return xs
    case (x :| xs_, y :| ys_):
      if x < y:
        return x :| merge(xs_, ys)
      return y :| merge(xs, ys_)

def mergesort(xs):
  if length(xs) < 2:
    return xs
  (ys, zs) = split(xs)
  return merge(mergesort(ys), mergesort(zs))

mergesort([3, 1, 2])
