def split(xs):
  return ([xs[i] for i in range(0, len(xs)) if i % 2 == 0], [xs[i] for i in range(0, len(xs)) if i % 2 == 1])

def merge(xs, ys):
  def go(i, j):
    if i == len(xs):
      return drop(j, ys)
    if j == len(ys):
      return drop(i, xs)
    if xs[i] < ys[j]:
      return [xs[i]] + go(i + 1, j)
    return [ys[j]] + go(i, j + 1)
  return go(0, 0)

def mergesort(xs):
  if len(xs) < 2:
    return xs
  (ys, zs) = split(xs)
  return merge(mergesort(ys), mergesort(zs))

mergesort([3, 1, 2])
