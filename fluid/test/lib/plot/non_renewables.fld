from fluid.view import AxisLabels, BarChart, Dimensions, MultiView, Point, ScatterPlot, Segment, StackedBar, TickLabels, Default

countries = ["BRA", "EGY", "IND", "JPN"]

def totalFor(year, country):
  [row] = [row for row in nonRenewables if row.year == year if row.country == country]

  return ((row.nuclearOut + row.gasOut) + row.coalOut) + row.petrolOut

def stack(year):
  return [Segment(country, totalFor(year, country)) for country in countries]

def yearData(year):
  return [row for row in nonRenewables if row.year == year if row.country |elem| countries]

MultiView([
  BarChart(
    caption="Non-renewables output",
    size=Dimensions(275, 185),
    tickLabels=TickLabels(Default, Default),
    stackedBars=[StackedBar(num_to_str(year), stack(year)) for year in range(2014, 2019)],
    legend=True
  ),
  ScatterPlot(
    caption="",
    points=[Point(
      sum([row.nuclearOut for row in yearData(year)]),
      sum([row.nuclearCap for row in yearData(year)])
    ) for year in range(2014, 2019)],
    labels=AxisLabels("Nuclear capacity", "Nuclear output")
  )
])
