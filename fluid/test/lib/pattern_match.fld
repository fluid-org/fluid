def zip3([], []):
  return []
def zip3([x1], [y1]):
  return (x1, y1) :| zip3([], [])
def zip3([x1, x2], [y1, y2]):
  return (x1, y1) :| zip3([x2], [y2])
def zip3([x1, x2, x3], [y1, y2, y3]):
  return (x1, y1) :| zip3([x2, x3], [y2, y3])
def zip3(x1 :| x2 :| x3 :| x4 :| xs, y1 :| y2 :| y3 :| y4 :| ys):
  return (x1, y1) :| (x2, y2) :| (x3, y3) :| (x4, y4) :| zip3(xs, ys)

length(zip3([3, 4, 5, 6], [5, 6, 7, 8]))
