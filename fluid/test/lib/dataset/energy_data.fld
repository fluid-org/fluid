from dataclasses import dataclass

@dataclass
class Renewable:
  year: int
  country: str
  energyType: str
  output: float
  capacity: float

@dataclass
class NonRenewable:
  country: str
  year: int
  nuclearOut: float
  nuclearCap: float
  gasOut: float
  gasCap: float
  coalOut: float
  coalCap: float
  petrolOut: float
  petrolCap: float

renewables: list[Renewable] = @doc("renewables") load_json(list[Renewable], "dataset/renewables_new.json")
nonRenewables: list[NonRenewable] = @doc("nonRenewables") load_json(list[NonRenewable], "dataset/non_renewables.json")
