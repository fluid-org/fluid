# This dataset contains methane emissions for the region of Africa and the Middle East.
# Model: REMIND; Scenario: MAGPIE-SSP5-8.5
from dataclasses import dataclass

@dataclass
class Emission:
  year: int
  type: str
  emissions: float

methane: list[Emission] = @doc("methane") load_json(list[Emission], "dataset/methane_emissions.json")
