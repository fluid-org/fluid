import fnum
from dtw import computeDTW
from slicing.dtw.dtw_inputs import seq1, seq2, window

def d(x, y):
  return (x - y) * (x - y)

def avg(x, y):
  return (x + y) / 2

def avgSeq(seq1, seq2, f):
  return map(lambda (i, j): f(nth(i, seq1), nth(j, seq2)))

(costs, matched) = computeDTW(seq1, seq2, d, window)
avgSeq(seq1, seq2, avg, matched)
