from dataset.energy_data import renewables, nonRenewables

from fluid.view import BarChart, MultiView, ScatterPlot, Default

def totalFor(year, country, rows):
  [row] = [row for row in rows if row["year"] == year if row["country"] == country]

  return ((row["nuclearOut"] + row["gasOut"]) + row["coalOut"]) + row["petrolOut"]

def stack(year):
  return [{ y: country, z: totalFor(year, country, nonRenewables) } for country in [
    "BRA",
    "EGY",
    "IND",
    "JPN"
  ]]

def isCountry(name, x):
  return name == x["country"]
def isYear(year, x):
  return year == x["year"]

def plot(year, countries):
  rens = filter(isYear(year), renewables)
  nonRens = filter(isYear(year), nonRenewables)

  def plotCountry(country):
    rens_ = filter(isCountry(country), rens)
    rensOut = sum(map(lambda x: x["output"], rens_))
    rensCap = sum(map(lambda x: x["capacity"], rens_))
    x = head(filter(isCountry(country), nonRens))
    nonRensCap = ((x["nuclearCap"] + x["petrolCap"]) + x["gasCap"]) + x["coalCap"]
    return {
      x: rensCap / (rensCap + nonRensCap),
      y: (rensOut + x["nuclearOut"]) / (rensCap + x["nuclearCap"])
    }

  return map(plotCountry, countries)

MultiView([
  BarChart(
    caption="Non-renewables by country",
    size={ width: 275, height: 185 },
    tickLabels={ x: Default, y: Default },
    stackedBars=
      [{ x: num_to_str(year), segments: stack(year) } for year in range(2014, 2019)],
    legend=True
  ),
  ScatterPlot(
    caption=
      "Clean energy efficiency vs proportion of renewable energy capacity",
    points=
      plot(2018, [ "BRA", "CHN", "DEU", "FRA", "EGY", "IND", "JPN", "MEX", "NGA", "USA" ]),
    labels={ x: "Renewables/TotalEnergyCap", y: "Clean Capacity Factor" }
  )
])
