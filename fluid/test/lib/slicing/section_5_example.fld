from math import floor
from slicing.section_5_example_inputs import data, types

def map(f, []):
  return []
def map(f, x :| xs):
  return f(x) :| map(f, xs)

output = [row["output"] for type in types for row in data if row["energyType"] == type]
map(lambda x: floor((x / sum(output)) * 100), output)
