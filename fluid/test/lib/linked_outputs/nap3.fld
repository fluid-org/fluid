from math import ceil, floor
from dataset.nap3 import nap3_actions, ccra3_risks

from fluid.view import BarChart, Dimensions, MultiView, Segment, StackedBar, TickLabels, Default, Rotated, Link
from fluid.prelude import fsum, nub

eval_scores: list[str] = [ "Significantly addressed", "Recognised but not addressed",
    "Not addressed", "Minimally addressed", "Fully addressed" ]

risks_: dict[str, dict[str, str]] = { r[ "ID#" ]: r for r in ccra3_risks }

actions: list[dict[str, str]] = [
    { "Action Owner": action[ "Action Owner" ], "Typology": action[ "Typology" ],
      "Evaluation score": action[ "Evaluation score" ], "Chapter": risks_[ action[ "Risk ID#" ] ][ "Chapter" ] }
    for action in nap3_actions
  ]

def actions_by(key: str, keys: list[str]) -> list[StackedBar]:
  def bar(key_: str) -> StackedBar:
    actions_: list[dict[str, str]] = [ action for action in actions if action[ key ] == key_ ]
    return StackedBar(x=key_,
      segments=[ Segment(y=eval_score,
          z=len([ action for action in actions_ if action[ "Evaluation score" ] == eval_score ]))
        for eval_score in eval_scores
      ])
  return [ bar(key_) for key_ in keys ]

actions_by_chapter: list[StackedBar] = actions_by("Chapter", [ "3", "4", "5", "6", "7" ])

departments: list[str] = [ "DBT", "DCMS", "Defra", "DESNZ", "DfT", "DHSC", "DLUHC", "DSIT", "FCDO", "HMT", "MoJ" ]

nat_env_and_infra_depts: list[str] = [ "Defra", "DESNZ", "DfT", "DLUHC" ]

by_action_owner: list[StackedBar] = actions_by("Action Owner", departments)

by_topology: list[StackedBar] = actions_by(
    "Typology",
    [ "No and low regret adaptation, including capacity building",
      "Climate-smart design, considering uncertainty",
      "Further investigation",
      "Early activities to support future adaptation",
      "Unclear typology noted in text" ]
  )

# action_counts: segments of a bar produced by actions_by
def total_actions(action_counts: list[Segment]) -> float:
  return fsum([ segment.z for segment in action_counts ])

def actions_with_score(action_counts: list[Segment], eval_score: str) -> float:
  return fsum([ segment.z for segment in action_counts if segment.y == eval_score ])

def proportion(x: float, y: float) -> float:
  return 0 if y == 0 else x / y

def max_with_score(actions: list[StackedBar], eval_score: str) -> float:
  return max([
    proportion(actions_with_score(action_counts, eval_score), total_actions(action_counts))
    for StackedBar(x=_, segments=action_counts) in actions
  ])

by_nat_env_and_infra: list[StackedBar] = actions_by("Action Owner", nat_env_and_infra_depts)

MultiView([
  f"""
  Climate Change Risk Assessment (CCRA3) identified {
    len(nub([ risk[ "Risk or Opportunity Descriptor" ] for risk in ccra3_risks ]))
  } risks/opportunities for the UK;
  this report evaluates extent to which NAP3 commitments actually address them.
  """,
  BarChart(
    caption="NAP3 actions by chapter",
    size=Dimensions(width=275, height=185),
    tickLabels=TickLabels(x=Default(), y=Default()),
    stackedBars=actions_by_chapter,
    legend=False
  ),
  BarChart(
    caption="NAP3 actions by government department",
    tickLabels=TickLabels(x=Rotated(), y=Default()),
    size=Dimensions(width=275, height=200),
    stackedBars=by_action_owner,
    legend=True
  ),
  f"""
  Disaggregating by department revealed marked disparities in government response. {
    Link(nat_env_and_infra_depts, "Natural environment and infrastructure sectors")
  } performed relatively well, with {
    floor(fsum([
      actions_with_score(action_counts, eval_score)
      for eval_score in [ "Fully addressed", "Minimally addressed" ]
      for StackedBar(x=_, segments=action_counts) in by_nat_env_and_infra
    ]))
  } of {
    floor(fsum([ total_actions(action_counts) for StackedBar(x=_, segments=action_counts) in by_nat_env_and_infra]))
  } actions at least “minimally addressed.”
  In contrast, business and industry actions lagged sharply, with nearly half unaddressed or only nominally
  recognized—an institutional lapse in private-sector resilience. Defra (Environment, Food and Rural Affairs)
  dominated, although only a small portion of were fully or significantly addressed. Departments
  with cross-sectoral mandates such as DSIT (Science & Technology) and HMT (Treasury) had smaller action bases
  and weaker scores. No department had more than {
    ceil(max_with_score(by_action_owner, "Fully addressed") * 100)
  }% of its actions fully addressed, reinforcing the impression of a fragmented governance system where adaptation
  remains siloed and under-resourced.
  """,
  f"""
  Of the {
    Link(
      [ (risk[ "Chapter" ], risk[ "Risk or Opportunity Descriptor" ])
        for risk in ccra3_risks if risk[ "CCC Priority" ] == "Yes"
      ],
      "committee's priority risks"
    )
  }, the distribution also reveals where policy attention is converging. Chapters 3 and 4 (Nature and
  Infrastructure) contain the densest clusters of actions, suggesting that physical-system adaptation still
  dominates the UK’s climate agenda. By contrast, social, business, and interdependency-related risks—those
  demanding coordination across institutions or behavioural change—show thinner coverage and weaker evaluation
  scores.
  """
])
