from dataset.methane_emissions import methane

from fluid.view import LineChart, LinePlot, Default, Rotated

def nthPad(n, xs):
  return nth(min(max(n, 0), length(xs) - 1), xs)
def movingAvg(ys, window):
  return [sum([nthPad(n, ys) for n in range(i - window, i + window + 1)]) / (1 + 2 * window) for i in range(0, length(ys))]
def movingAvg_(rs, window):
  return zip_with(lambda x, y: { x: x, y: y }, map(lambda r: r["x"], rs), movingAvg(map(lambda r: r["y"], rs), window))

points = [{ x: r["year"], y: r["emissions"] } for r in methane if r["type"] == "Agriculture"]

LineChart(
  tickLabels={ x: Rotated, y: Default },
  size={ width: 330, height: 285 },
  caption="SSP5-8.5 projected methane emissions (Agriculture)",
  plots=[
    LinePlot(
      name="Moving average",
      points=movingAvg_(points, 1)
    ),
    LinePlot(name="Original curve", points=points)
  ]
)
