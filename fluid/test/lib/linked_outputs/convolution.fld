from fluid.matrix import zero, wrap, convolve

data: list[list[int]] = @doc("data") [
  [15, 13, 6, 9, 16],
  [12, 5, 15, 4, 13],
  [14, 9, 20, 8, 1],
  [4, 10, 3, 7, 19],
  [3, 11, 15, 2, 9]
]

filter1_: list[list[int]] = [
    [0, 0, 0],
    [3, 7, 1],
    [0, 0, 0]
  ]
filter1: Matrix[int] = [| filter1_[i][j] for (i, j) in (3, 3) |]
image1: Matrix[int] = [| data[i][j] for (i, j) in (5, 5) |]
filter2_: list[list[int]] = [
    [0, 2, 0],
    [0, 7, 0],
    [0, 5, 0]
  ]
filter2: Matrix[int] = [| filter2_[i][j] for (i, j) in (3, 3) |]
image2: Matrix[int] = [| data[i][j] for (i, j) in (5, 5) |]

convolve(image1, filter1, wrap), convolve(image2, filter2, zero)
